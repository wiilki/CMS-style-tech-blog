# Copy this file to .env for local MySQL development. Do not commit your actual .env.
DB_NAME=blogpost_db
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
SESSION_SECRET=replace-with-a-random-string-at-least-32-characters-long

# On Render, DATABASE_URL is provided by the Blueprint database.
# DATABASE_URL=postgresql://user:password@host:5432/database
# DB_SSL=true
# PORT=3001
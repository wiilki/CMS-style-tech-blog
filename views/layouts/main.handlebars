<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#111827">
  <meta name="description" content="The Byte — practical perspectives on code, software, and the people building the web.">
  <title>{{#if pageTitle}}{{pageTitle}} · {{/if}}The Byte — A developer's journal</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <script defer src="/js/site.js"></script>
</head>
<body>
<a class="skip-link" href="#main-content">Skip to content</a>
<div class="site-shell">
  <header class="site-header">
    <div class="container header-inner">
      <a class="brand" href="/" aria-label="The Byte homepage"><span class="brand-mark" aria-hidden="true">b<span>.</span></span><span class="brand-name">the byte<span class="brand-dot">.</span></span></a>
      <nav class="main-nav" aria-label="Main navigation">
        <a class="nav-link {{#if isHome}}active{{/if}}" href="/">Discover</a>
        {{#if loggedIn}}<a class="nav-link {{#if isDashboard}}active{{/if}}" href="/dashboard">My studio</a>{{/if}}
      </nav>
      <div class="header-actions">
        <button class="theme-toggle" type="button" id="theme-toggle" aria-label="Toggle color theme" title="Toggle color theme"><span aria-hidden="true">◐</span></button>
        {{#if loggedIn}}
        <a class="button button-small button-primary header-write" href="/dashboard/create">+ Write a story</a>
        <button class="header-logout" type="button" id="logout">Log out</button>
        {{else}}
        <a class="login-link" href="/login">Log in</a>
        <a class="button button-small button-primary" href="/signup">Join the conversation <span aria-hidden="true">↗</span></a>
        {{/if}}
      </div>
    </div>
  </header>
  <main id="main-content">{{{body}}}</main>
  <footer class="site-footer">
    <div class="container footer-inner">
      <div><a class="footer-brand" href="/">the byte<span>.</span></a><p>Curious minds. Better software.</p></div>
      <div class="footer-right"><a href="/">Explore stories</a><span>Made for people who build things. © <span id="year">2026</span></span></div>
    </div>
  </footer>
</div>
{{#if loggedIn}}<script src="/js/logout.js"></script>{{/if}}
</body>
</html>